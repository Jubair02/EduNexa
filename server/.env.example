# ---------------------------------------------------------------------------
# EduNexa — server environment
#
# Copy to server/.env and fill in real values. Never commit .env: it is listed
# in .gitignore for exactly that reason.
#
# Required: MONGODB_URI, JWT_SECRET. Everything else has a working default.
# ---------------------------------------------------------------------------

# ---- Server ---------------------------------------------------------------
PORT=5000
# development | production | test
NODE_ENV=development

# ---- Database (required) --------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/lms
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/lms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# ---- Auth (required) ------------------------------------------------------
# Must be at least 32 characters in production — startup refuses to boot
# otherwise. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS -----------------------------------------------------------------
# The browser origin(s) allowed to call this API. Comma-separate several.
# Never a wildcard: the API is credentialed.
CLIENT_URL=http://localhost:5173

# ---- Proxy ----------------------------------------------------------------
# Number of reverse proxies in front of the API. Set to 1 on hosts that
# terminate TLS for you (Render, Railway, Heroku, an nginx ingress); leaving it
# at 0 there makes rate limiting see every visitor as the same client.
TRUST_PROXY_HOPS=0

# ---- Limits ---------------------------------------------------------------
# Max JSON body. Lesson content allows 50 000 characters, so do not go below
# ~200kb or the longest legal lesson becomes unsavable.
JSON_BODY_LIMIT=1mb

# Rate limiting. AUTH covers login/register (per IP + email, successful logins
# are not counted); WRITE covers quiz submission (per account); API is a
# whole-surface backstop.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=300
RATE_LIMIT_API_MAX=1000

# ---- Cloudinary (file storage) -------------------------------------------
# Leave empty to disable uploads; the rest of the app keeps working and the
# upload endpoint answers 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
